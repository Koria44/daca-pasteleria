# ==========================================
# Variables de Entorno - Daca Pastelería
# ==========================================
# Copia este archivo como .env y completa tus valores:
# cp .env.example .env

# Seguridad Django
# En producción genera una clave secreta aleatoria y pon DEBUG=False
SECRET_KEY=django-insecure-cambiar-por-una-clave-secreta-aleatoria-en-produccion
DEBUG=True

# Hosts permitidos separados por comas
# Para producción en Render/Railway/PythonAnywhere agrega tu dominio:
# ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com,.railway.app
ALLOWED_HOSTS=127.0.0.1,localhost

# Dominios de confianza CSRF (imprescindible para HTTPS en hosts gratuitos)
# CSRF_TRUSTED_ORIGINS=https://tu-app.onrender.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# Base de datos
# Por defecto usa SQLite local (sqlite:///db.sqlite3)
# Para PostgreSQL en Render/Railway/Supabase/Neon:
# DATABASE_URL=postgres://usuario:password@host:5432/nombre_db
DATABASE_URL=sqlite:///db.sqlite3

# Correo electrónico (en desarrollo sale por consola)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_contraseña_de_aplicacion
DEFAULT_FROM_EMAIL=Daca Pastelería <contacto@dacapasteleria.cl>

# Información pública de contacto
WHATSAPP_PHONE=56912345678
INSTAGRAM_USER=@dacapasteleria
STORE_ADDRESS=Rojas Magallanes 055, La Florida, Santiago, Chile

# Transbank Webpay Plus (Integración / Sandbox oficial de pruebas)
# Para producción cambiar a 'production' y poner tus credenciales oficiales de Transbank
TBK_ENVIRONMENT=integration
TBK_COMMERCE_CODE=597055555532
TBK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
